---
import PageLayout from '../../layouts/PageLayout.astro';
import { SITE_URL } from '../../data/site-config';
import { route } from '../../i18n/routes';
import { breadcrumbSchema } from '../../lib/seo';
const lang = 'en';
const code = `<iframe src="${SITE_URL}/embed/self-certification-form/" title="Italian self-certification form" width="100%" height="1200" style="border:0;max-width:1100px" loading="lazy"></iframe>`;
---
<PageLayout title="Embed the Italian self-certification generator on your site" description="Embed the Italian self-certification, delegation and notice-letter generator for free with an iframe: one snippet to copy, no sign-up, no cookies, kept up to date." lang={lang} noindex={true} jsonLd={[breadcrumbSchema([{ name: 'Home', path: route('home', lang) }, { name: 'Widget', path: route('widget', lang) }])]} breadcrumbs={[{ label: 'Widget' }]} showAuthor={false}>
  <header class="mb-6">
    <h1 class="text-3xl font-bold text-navy-900 md:text-4xl">Embed the form generator</h1>
    <p class="mt-3 text-lg text-navy-700">One snippet to copy, no sign-up and no fee. Schools, associations, help desks and expat sites set it up in a minute.</p>
  </header>
  <div class="prose prose-slate max-w-none">
    <pre class="overflow-x-auto rounded-lg bg-navy-900 p-4 text-sm text-white"><code>{code}</code></pre>
    <p>Terms: the link under the tool stays visible, the tool is not altered and it comes with no warranty. When a statute changes, the form is updated here and your page follows with no work on your side. Italian version: <code>{`${SITE_URL}/embed/modulo-autocertificazione/`}</code>.</p>
    <p>What your visitors type stays in their browser: nothing goes through our servers and the embedded frame sets no cookie on your site. For any request, use the <a href={route('contact', lang)}>contact page</a>.</p>
  </div>
  <div class="mt-8 overflow-hidden rounded-xl border border-navy-200">
    <iframe src="/embed/self-certification-form/" title="Italian self-certification form" width="100%" height="1200" style="border:0" loading="lazy"></iframe>
  </div>
</PageLayout>
