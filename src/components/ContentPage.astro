---
/**
 * Page d'un document (src/content/pagine/) : H1 et chapeau avec le mot-clé, mention « site indépendant »
 * juste après (jamais avant l'introduction, check-motcle), bloc citable replié, puis le générateur
 * (page outil, `data-outil`) et le texte. FAQ, pages associées, sources et encart auteur viennent du
 * PageLayout, avec la FAQ affichée et balisée depuis la même liste (§7).
 */
import PageLayout from '../layouts/PageLayout.astro';
import MiniSim from './calc/MiniSim';
import Clamp from './Clamp.astro';
import Generatore from './doc/Generatore';
import { route, ROUTES, type Locale } from '../i18n/routes';
import { label } from '../i18n/nav';
import { t } from '../i18n/ui';
import { pageById } from '../lib/guides';
import { helpers } from '../lib/helpers';
import { replieSezioni } from '../lib/sezioni';
import { P } from '../lib/engine/params';
import { articleSchema, faqSchema, breadcrumbSchema, webPageSchema, webApplicationSchema } from '../lib/seo';
import { AUTHOR_NAME } from '../data/site-config';
import type { PageDef } from '../lib/guide-types';
interface Props { page: PageDef; lang: Locale }
const { page, lang } = Astro.props;
const x = page[lang];
const ui = t(lang);
const path = route(page.id, lang);
const H = helpers(lang);
const parts = replieSezioni(x.body(H)).split(/<!--mini:([A-Za-z0-9_]+)-->/);
const resume = x.resume(H);
const faqs = x.faqs(H);
const jsonLd = [articleSchema({ title: x.h1, description: x.description, path, lang }), webPageSchema({ name: x.h1, description: x.description, path, lang }), breadcrumbSchema([{ name: ui.breadcrumbHome, path: route('home', lang) }, { name: x.nav, path }]), webApplicationSchema({ name: x.h1, description: x.description, path, lang })];
if (faqs.length) jsonLd.push(faqSchema(faqs, lang));
const related = page.related.filter((id) => ROUTES.some((r) => r.id === id)).map((id) => ({ href: route(id, lang), name: label(id, lang), description: pageById(id)?.[lang].card ?? '' }));
const sources = page.sources.map((k) => ({ name: P.sources[k].label[lang], url: P.sources[k].url }));
const methodHref = route('method', lang);
---
<PageLayout title={x.title} description={x.description} lang={lang} jsonLd={jsonLd} faqs={faqs} related={related} sources={sources} breadcrumbs={[{ label: x.nav }]}>
  <article>
    <header class="mb-3">
      <h1 class="text-[1.75rem] font-bold text-navy-900 max-sm:leading-tight sm:text-3xl md:text-4xl">{x.h1}</h1>
    </header>
    <p class="text-base text-navy-700 sm:text-lg">{x.intro}</p>
    <p data-chrome class="mt-2 text-sm text-navy-600">{ui.independent}</p>
    <div data-outil data-chrome class="mb-4 mt-3">
      <Generatore client:load lang={lang} id={`gen-${page.id}`} doc={page.doc} methodHref={methodHref} />
    </div>
    <Clamp text={resume} lang={lang} id={`clamp-${page.id}`} class="mb-4 mt-3" />
    <p class="mb-10 text-sm text-navy-600">{ui.reviewedBy} <a href={route('about', lang)} class="underline hover:text-navy-900">{AUTHOR_NAME}</a> · <a href={route('editorial', lang)} class="underline hover:text-navy-900">{ui.editorialPolicy}</a> · <a href={methodHref} class="underline hover:text-navy-900">{label('method', lang)}</a></p>
    <p data-chrome class="mb-2 text-sm text-navy-600">{lang === 'it' ? 'Le spiegazioni sono divise per domanda: tocca un titolo per leggerla.' : 'The explanations are split by question: tap a heading to read it.'}</p>
    <div class="prose prose-slate max-w-none">
      {parts.map((p, i) => i % 2 === 0 ? <Fragment set:html={p} /> : <div class="mini-bloc" data-simulateur-secondaire><MiniSim client:load kind={p} lang={lang} /></div>)}
    </div>
  </article>
</PageLayout>
